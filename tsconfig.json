{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["nuxt/schema", "node"],
    "baseUrl": ".",
    "paths": {
      "~": ["app"],
      "~/": ["app/"]
    }
  },
  "include": [".nuxt/types/**/*.ts", "app/**/*.ts", "app/**/*.vue", "app/**/*.tsx"]
}
